# Style for the shared C++ core (cpp/), JNI, and Objective-C++ (ios/).
# Matches the header snippets in detailed-implementation-plan.md:
# 4-space indent, left-aligned pointers, 100-column limit.
# Note: cpp/third_party/rlottie/ is vendored and excluded from formatting.
---
Language: Cpp
BasedOnStyle: Google
Standard: c++17
IndentWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
AccessModifierOffset: -4
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
AllowShortLoopsOnASingleLine: false
IncludeBlocks: Preserve
SortIncludes: CaseSensitive
SpaceAfterCStyleCast: false
---
Language: ObjC
BasedOnStyle: Google
IndentWidth: 4
ColumnLimit: 100
PointerAlignment: Left
ObjCBlockIndentWidth: 4
ObjCSpaceAfterProperty: true
ObjCSpaceBeforeProtocolList: true
