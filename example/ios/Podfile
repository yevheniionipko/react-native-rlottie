# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'RlottieExample' do
  config = use_native_modules!

  # react-native-rlottie ships both the Legacy Architecture and a Fabric/
  # TurboModule path (see docs/new-architecture-design.md). This example is
  # the dual-architecture verification harness, so it reads
  # RCT_NEW_ARCH_ENABLED from the environment instead of hardcoding a mode:
  #   RCT_NEW_ARCH_ENABLED=1 pod install   -> Fabric + TurboModules
  #   pod install                          -> Legacy Architecture (default)
  new_arch_enabled = ENV['RCT_NEW_ARCH_ENABLED'] == '1'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => new_arch_enabled,
    :new_arch_enabled => new_arch_enabled
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Unrelated to react-native-rlottie: RN 0.81's RCT-Folly pulls in `fmt`
    # 11.0.2 (via node_modules/react-native/third-party-podspecs/fmt.podspec),
    # which only disables its `consteval` codepath for Apple clang builds
    # older than 14000029 (fmt/include/fmt/base.h's FMT_USE_CONSTEVAL check).
    # This machine's Xcode (26.6) ships a MUCH newer Apple clang that isn't
    # older than that threshold, so fmt assumes `consteval` is safe — but its
    # `FMT_STRING("{}{}")` call sites in format-inl.h (used by RCT-Folly's
    # error-formatting helpers, not by anything of ours) fail to compile on
    # it: "call to consteval function ... is not a constant expression".
    #
    # A `GCC_PREPROCESSOR_DEFINITIONS=FMT_USE_CONSTEVAL=0` override does NOT
    # work here (tried first): `fmt/include/fmt/base.h` computes
    # `FMT_USE_CONSTEVAL` with a plain `#define`, no `#ifndef` guard, so its
    # own compiler-version detection unconditionally clobbers any externally
    # supplied value the moment the header is included. The only place left
    # to intervene is the header text itself. `pod install` re-copies fmt's
    # source from the released gem every time, so this can't be a one-off
    # source edit — it has to be a patch reapplied here, in `post_install`,
    # on every install.
    fmt_base_header = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base_header)
      contents = File.read(fmt_base_header)
      marker = "#elif defined(__apple_build_version__) && __apple_build_version__ < 14000029L\n#  define FMT_USE_CONSTEVAL 0  // consteval is broken in Apple clang < 14."
      replacement = "#elif defined(__apple_build_version__)\n#  define FMT_USE_CONSTEVAL 0  // react-native-rlottie/example: broken on Xcode 26.6's clang too (newer than fmt 11.0.2's detection table) — see ios/Podfile post_install."
      if contents.include?(marker)
        # CocoaPods installs vendored pod sources read-only (0444) to
        # discourage accidental edits; must reopen for write every time this
        # runs, since a fresh 0444 copy is exactly what the previous
        # `pod install` just placed here.
        File.chmod(0644, fmt_base_header)
        File.write(fmt_base_header, contents.sub(marker, replacement))
        File.chmod(0444, fmt_base_header)
      elsif !contents.include?('react-native-rlottie/example')
        Pod::UI.warn "react-native-rlottie example: fmt/base.h's FMT_USE_CONSTEVAL detection text has changed upstream — the Xcode-26 consteval patch in ios/Podfile no longer applies; re-check the fmt build error manually."
      end
    end
  end
end
