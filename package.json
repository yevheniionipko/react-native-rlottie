{
  "name": "@yevheniionipko/react-native-rlottie",
  "version": "0.1.0",
  "description": "High-performance Lottie animations for React Native, rendered natively via the rlottie C++ engine (Legacy Architecture, RN <= 0.81).",
  "repository": {
    "type": "git",
    "url": "https://github.com/yevheniionipko/react-native-rlottie.git"
  },
  "homepage": "https://github.com/yevheniionipko/react-native-rlottie#readme",
  "bugs": {
    "url": "https://github.com/yevheniionipko/react-native-rlottie/issues"
  },
  "author": "yevheniionipko",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cpp",
    "ios",
    "android",
    "react-native-rlottie.podspec",
    "react-native.config.js",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "!**/__tests__",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!android/build",
    "!android/.cxx",
    "!android/.gradle",
    "!android/settings.gradle",
    "!android/gradle.properties",
    "!ios/build",
    "!**/.DS_Store",
    "!**/*.o",
    "!**/*.a",
    "!**/*.so",
    "!**/CMakeFiles",
    "!**/CMakeCache.txt"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:js": "tests/js/run-tests.sh",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:cpp": "find cpp ios android -type f \\( -name '*.h' -o -name '*.hpp' -o -name '*.cpp' -o -name '*.mm' -o -name '*.m' \\) -exec clang-format -i {} +",
    "verify:abis": "scripts/verify-abis.sh",
    "verify:npm-package": "scripts/verify-npm-package.sh",
    "prepare": "echo \"[react-native-rlottie] no build step yet (added in a later phase)\""
  },
  "keywords": [
    "react-native",
    "lottie",
    "rlottie",
    "animation",
    "ios",
    "android",
    "native-component"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.68.0 <0.82.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "react": "19.1.0",
    "react-native": "0.81.0",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "codegenConfig": {
    "name": "RNRlottieSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.rlottie.spec"
    },
    "ios": {
      "componentProvider": {
        "RlottieView": "RNRlottieComponentView"
      },
      "components": {
        "RlottieView": {
          "className": "RNRlottieComponentView"
        }
      },
      "modules": {
        "RlottieModule": {
          "className": "RNRlottieModule"
        }
      }
    }
  }
}
